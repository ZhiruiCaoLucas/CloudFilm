root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
indent_style = tab

# ------------------------------------------------------------------
# C# code style - enforced at build time (EnforceCodeStyleInBuild)
# ------------------------------------------------------------------
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ------------------------------------------------------------------
# EF Core migrations - machine generated, style rules do not apply
# ------------------------------------------------------------------
# `dotnet ef migrations add` writes three files. Two of them carry an
# `// <auto-generated />` header, so analysers skip them automatically:
# `*.Designer.cs` and `<Context>ModelSnapshot.cs`. The migration itself does
# NOT carry that header - EF omits it deliberately, because a migration is
# meant to be editable when a schema change needs hand-written SQL. Roslyn
# therefore treats it as ordinary source and enforces the rules above on it:
# IDE0161 (file-scoped namespace) and IDE0005 (unnecessary usings) both fire,
# and TreatWarningsAsErrors turns them into a failed build.
#
# The generator's output is not ours to style, and reformatting it would be
# undone by the next `migrations add`. Style enforcement exists to keep
# hand-written code consistent, so it is switched off for this path only.
#
# Scoped to the Style category, NOT to generated-code status. Marking these
# files `generated_code = true` would have been shorter, but it would also
# silence every CA rule on them - and correctness, security and reliability
# analysis should still run over code that creates the database schema.
# CA rules therefore remain fully active here.
#
# The two IDE entries below are not redundant: a rule-ID severity takes
# precedence over a category severity, so the explicit `IDE0005 = error` in
# the [*.cs] section above would otherwise still win for these files.
[**/Migrations/*.cs]
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
