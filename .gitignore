# ---------- Python ----------
# The analysis service. Interpreter artefacts and test caches only - the service
# itself is source, like every other app in this repository.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
apps/analysis/.venv/

# ---------- Env & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/

# ---------- Docker / runtime data ----------
.data/
docker/volumes/

# ---------- Local development imaging data ----------
# Sample DICOM is patient-shaped data and can be large; it is supplied locally,
# never committed. The directory itself is kept.
services/orthanc/seed/*
!services/orthanc/seed/.gitkeep

# ---------- Editors & OS ----------
.idea/
.DS_Store
Thumbs.db
*.swp

# Build output captured while debugging a container build. Never a source file.
build.log
