# ---------------------------------------------------------------------------
# Portal - local development overrides.
#
# You do NOT need this file to get started. `pnpm install && pnpm dev` works
# with no configuration: the values below are exactly what the portal falls
# back to in development.
#
# Copy to `.env.local` (git-ignored) only when you need to point the portal at
# something other than the standard local port map.
#
#   cp apps/portal/.env.example apps/portal/.env.local
#
# Deployments do not use this file. Docker Compose supplies these variables from
# the repository-root `.env`; see `.env.example` there.
# ---------------------------------------------------------------------------

# Address of the CloudFilm API, as the PORTAL SERVER reaches it.
# Never sent to the browser. 8080 is the port used both by `docker compose up`
# and by `dotnet run --project apps/api/src/CloudFilm.Api`.
CLOUDFILM_API_URL=http://localhost:8080

# Address of the OHIF Viewer, as a BROWSER reaches it.
# Used as the viewer iframe's `src`, so it must be resolvable from the browser -
# a container name will not work.
CLOUDFILM_VIEWER_URL=http://localhost:8081
