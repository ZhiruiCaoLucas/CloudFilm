<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API host - the composition root.
    This is the only project that is allowed to know about every other layer.
    It contains wiring and transport concerns, never business rules.
  -->

  <PropertyGroup>
    <RootNamespace>CloudFilm.Api</RootNamespace>
    <UserSecretsId>cloudfilm-api</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudFilm.Infrastructure\CloudFilm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudFilm.Api.Tests" />
  </ItemGroup>

</Project>
