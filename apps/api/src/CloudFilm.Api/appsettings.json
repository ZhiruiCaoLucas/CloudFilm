{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Infrastructure": {
    "PostgresConnectionString": "",
    "RedisConnectionString": "",
    "RedisInstanceName": "cloudfilm:",
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "https://cloudfilm.local",
    "Audience": "cloudfilm-portal",
    "SigningKey": "",
    "ClockSkewSeconds": 30
  },
  "Portal": {
    "AllowedOrigins": []
  },
  "Downstream": {
    "RetrieveServiceUrl": "",
    "OrthancUrl": ""
  },
  "AllowedHosts": "*"
}
