<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer.
    Contains the concrete adapters for the ports declared in the Application layer:
    PostgreSQL persistence, Redis caching, ASP.NET Identity storage.
    Nothing outside this project may reference EF Core or StackExchange.Redis.
  -->

  <PropertyGroup>
    <RootNamespace>CloudFilm.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudFilm.Application\CloudFilm.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />

    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- Token issuance. Version matches the Microsoft.IdentityModel stack that
         Microsoft.AspNetCore.Authentication.JwtBearer 9.0.0 already resolves in
         the API project, so validation and issuance share one implementation. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />

    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />

    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudFilm.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
  <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
