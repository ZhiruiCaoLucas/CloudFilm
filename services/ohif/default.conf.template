server {
  gzip_static always;
  gzip_proxied expired no-cache no-store private auth;
  gunzip on;

  listen ${PORT} default_server;
  listen [::]:${PORT} default_server;

  location /dicom-web/ {
    proxy_pass http://orthanc:8042/dicom-web/;

    # $http_host, not $host: nginx's $host drops the port, so Orthanc saw
    # "localhost" and generated RetrieveURL (00081190) as
    # http://localhost/dicom-web/... - port 80, where nothing listens. Metadata
    # and QIDO were unaffected because OHIF builds those from its own configured
    # root; only server-generated bulk-data URLs broke. $http_host preserves
    # "localhost:8081", making those URLs same-origin with the viewer document,
    # so bulk data needs no preflight and no CORS.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Basic Auth. Substituted from the environment by the image's entrypoint, so
    # the credential lives in .env with every other secret and never in a tracked
    # file. Attached here, server side, so it never reaches the browser.
    proxy_set_header Authorization "Basic ${ORTHANC_BASIC_AUTH}";}

  location / {
    root /usr/share/nginx/html;
    index index.html index.htm;
    try_files $uri $uri/ ${PUBLIC_URL}index.html;

    add_header Cross-Origin-Resource-Policy same-origin;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  error_page 500 502 503 504 /50x.html;

  location = /50x.html {
    root /usr/share/nginx/html;
  }
}
