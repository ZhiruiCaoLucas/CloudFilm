# ---------------------------------------------------------------------------
# CloudFilm environment.
# Copy to .env and replace every secret. `.env` is git-ignored and must never be
# committed. Generate secrets with: ./scripts/generate-secrets.sh
# ---------------------------------------------------------------------------

# --- Hosting -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
PORTAL_PUBLIC_PORT=3000
API_PUBLIC_PORT=8080
VIEWER_PUBLIC_PORT=8081

# Addresses as a BROWSER sees them. Used for CORS and for the viewer iframe.
PORTAL_PUBLIC_URL=http://localhost:3000
VIEWER_PUBLIC_URL=http://localhost:8081

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=cloudfilm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudfilm

# --- Orthanc -----------------------------------------------------------------
# Pin both third-party images to an immutable digest before hospital deployment.
ORTHANC_IMAGE=orthancteam/orthanc:latest
OHIF_IMAGE=ohif/app:latest
ORTHANC_PASSWORD=change-me
ORTHANC_DB_PASSWORD=change-me

# --- API ---------------------------------------------------------------------
# Applies EF Core migrations on start. Leave true for local and staging; set
# false for production, where schema changes are part of a controlled release.
API_AUTO_MIGRATE=true

JWT_ISSUER=https://cloudfilm.local
JWT_AUDIENCE=cloudfilm-portal
# Must be at least 32 characters.
JWT_SIGNING_KEY=change-me-to-a-32-character-minimum-secret

# --- Retrieve Service --------------------------------------------------------
# How long a staged study may remain in Orthanc (d.hh:mm:ss or hh:mm:ss).
RETRIEVE_STAGING_LIFETIME=12:00:00
