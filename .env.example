# ---------------------------------------------------------------------------
# CloudFilm - deployment environment (Docker Compose).
#
# Needed for `docker compose up`, NOT for `pnpm dev`. The portal alone runs with
# no configuration at all; see `apps/portal/.env.example`.
#
#   ./scripts/generate-secrets.sh     # writes .env with generated secrets
#
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Hosting -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Published ports. These are the standard CloudFilm port map, shared by the
# Compose stack and by running services from source:
#   3000 portal   8080 api   8081 viewer   8082 retrieve (dev overlay only)
PORTAL_PUBLIC_PORT=3000
API_PUBLIC_PORT=8080
VIEWER_PUBLIC_PORT=8081

# Addresses as a BROWSER sees them. PORTAL_PUBLIC_URL drives CORS on the API;
# VIEWER_PUBLIC_URL becomes the viewer iframe's src. Both must be externally
# resolvable hostnames in a real deployment, never container names.
PORTAL_PUBLIC_URL=http://localhost:3000
VIEWER_PUBLIC_URL=http://localhost:8081

# --- Third-party images ------------------------------------------------------
# Pin both to an immutable digest before any hospital deployment.
ORTHANC_IMAGE=orthancteam/orthanc:latest
OHIF_IMAGE=ohif/app:latest

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=cloudfilm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudfilm

# --- Orthanc -----------------------------------------------------------------
ORTHANC_PASSWORD=change-me
ORTHANC_DB_PASSWORD=change-me

# --- API ---------------------------------------------------------------------
# Applies EF Core migrations on start. Leave true for local and staging; set
# false for production, where schema changes are part of a controlled release.
API_AUTO_MIGRATE=true

JWT_ISSUER=https://cloudfilm.local
JWT_AUDIENCE=cloudfilm-portal
# Must be at least 32 characters.
JWT_SIGNING_KEY=change-me-to-a-32-character-minimum-secret

# --- Retrieve Service --------------------------------------------------------
# How long a staged study may remain in Orthanc (d.hh:mm:ss or hh:mm:ss).
RETRIEVE_STAGING_LIFETIME=12:00:00
